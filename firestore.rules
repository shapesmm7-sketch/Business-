rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Push notification device tokens
    match /notification_tokens/{tokenId} {
      allow read: if isValidId(tokenId);
      allow create, update: if isValidId(tokenId)
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().token is string && incoming().token.size() <= 2048
        && incoming().platform is string && incoming().platform.size() <= 32
        && incoming().enabled is bool;
      allow delete: if isValidId(tokenId);
    }

    // App activity & push notification feed
    match /app_notifications/{notificationId} {
      allow read: if isValidId(notificationId);
      allow create: if isValidId(notificationId)
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().title is string && incoming().title.size() <= 256
        && incoming().body is string && incoming().body.size() <= 2048
        && incoming().type is string && incoming().type.size() <= 64
        && incoming().isRead is bool;
      allow update: if isValidId(notificationId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isValidId(notificationId);
    }
  }
}
