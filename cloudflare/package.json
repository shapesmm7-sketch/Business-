{
  "name": "brivu-cloudflare-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend for Brivu with D1 database and R2 object storage",
  "main": "worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create brivu-db",
    "d1:init": "wrangler d1 execute brivu-db --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create brivu-files"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.8.2",
    "wrangler": "^3.78.0"
  }
}
